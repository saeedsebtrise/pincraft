# Optional. Leave unset to run the editor fully offline with local headline suggestions.
# Client-side: only the URL of YOUR proxy, never a key.
VITE_AI_PROXY_URL=/api/ai

# Server-side only (server/ai-proxy.mjs locally, api/ functions on Vercel). Never prefix with VITE_.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI routes need a signed-in user on Vercel; set true to test that locally (false turns it off online — not recommended).
# AI_REQUIRE_LOGIN=

# SaaS (optional) - see docs/SAAS_SETUP.md. Public values only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_LEMON_CHECKOUT_URL=

# Shown on the Billing and Settings pages as the support contact (optional).
VITE_SUPPORT_EMAIL=

# Pinterest connection (server only — see docs/PINTEREST_SETUP.md). Never prefix with VITE_.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Any long random string; encrypts users' Pinterest tokens.
PINTEREST_TOKEN_SECRET=
# PINTEREST_REDIRECT_URI=

# Optional Autopilot worker only. Never prefix these with VITE_.
# npm run autopilot loads .env locally. Use GitHub environment secrets/variables in the cloud.
# See docs/AUTOPILOT_SETUP.md for the separate Apps Script properties and Make setup.
GEMINI_API_KEY=
# Select an available Gemini model supporting generateContent with JSON output.
GEMINI_MODEL=
AUTOPILOT_MODE=preview
AUTOPILOT_PREVIEW_URL=
AUTOPILOT_ENABLED=false
# Example structure only: [{"id":"YOUR_NUMERIC_BOARD_ID","name":"Your board name"}]
AUTOPILOT_BOARDS_JSON=[]
# Optional: A–H for one Pin design; empty or rotate = rotate per article
AUTOPILOT_TEMPLATE=
AUTOPILOT_SHEET_URL=
# At least 32 random characters; must match Apps Script SHARED_SECRET.
AUTOPILOT_SHEET_SECRET=
MAKE_WEBHOOK_URL=
# Recommended: match the Custom webhook API-key authentication setting.
MAKE_WEBHOOK_API_KEY=
