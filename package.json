{
  "name": "pincraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ai-proxy": "node server/ai-proxy.mjs",
    "autopilot": "node --env-file-if-exists=.env autopilot/run.mjs",
    "lint": "eslint autopilot src/dashboard/AutopilotPage.tsx src/test/autopilot*.test.{ts,tsx} --max-warnings 0",
    "test:autopilot": "node --test autopilot/*.nodecheck.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "idb-keyval": "^6.2.1",
    "konva": "^9.3.18",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
